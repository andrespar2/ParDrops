# ============================================================================
# ParDrops - variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo como .env.local para desarrollo y rellena los valores.
# En producción NUNCA se sube este archivo: las variables se configuran en
# Render (backend) y Cloudflare Pages (frontend).
#
#   cp .env.example .env.local
#   .\dev.ps1
# ============================================================================

# ----------------------------------------------------------------------------
# Backend: Spring Boot
# ----------------------------------------------------------------------------
# Perfil activo: "dev" en local, "prod" en Render.
# SPRING_PROFILES_ACTIVE=prod

# Base de datos. En local se usa H2 en archivo y no hace falta tocar nada.
# En producción, Neon entrega una URL con este formato:
#   DATABASE_URL=postgresql://usuario:clave@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Se puede usar DATABASE_URL (se convierte a JDBC al arrancar) o directamente
# SPRING_DATASOURCE_URL con el prefijo jdbc:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=usuario
# SPRING_DATASOURCE_PASSWORD=clave
# DB_POOL_SIZE=5

# Clave de firma de los JWT (mínimo 32 caracteres). Obligatoria en producción:
# si no se define, la aplicación usa la clave de desarrollo.
APP_JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# Orígenes permitidos por CORS, separados por comas.
# APP_CORS_ALLOWED_ORIGINS=https://pardrops.qd.je,http://localhost:4200

# URL pública del frontend (enlaces de correo y retorno de OAuth2).
APP_FRONTEND_URL=http://localhost:4200

# ----------------------------------------------------------------------------
# Acceso con Google (opcional)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
# Marca las cookies del flujo OAuth2 como Secure (obligatorio en HTTPS).
APP_OAUTH2_SECURE_COOKIES=false

# ----------------------------------------------------------------------------
# Correo transaccional
# ----------------------------------------------------------------------------
# Sin SMTP, los correos se guardan en ./data/mail-outbox.
MAIL_ENABLED=false
MAIL_FROM=no-reply@pardrops.local
MAIL_FROM_NAME=ParDrops
MAIL_OUTBOX_DIR=./data/mail-outbox

# Para enviar correos reales (por ejemplo, Gmail con contraseña de aplicación):
# MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@gmail.com
# MAIL_PASSWORD=tu-contraseña-de-aplicacion
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# ----------------------------------------------------------------------------
# Almacenamiento de imágenes
# ----------------------------------------------------------------------------
# Directorio local del almacén (en producción se usa PostgreSQL).
APP_MEDIA_STORAGE_DIR=./data/media

# ----------------------------------------------------------------------------
# Semilla inicial
# ----------------------------------------------------------------------------
# Cuenta de administrador creada al primer arranque.
APP_SEED_ADMIN_EMAIL=admin@pardrops.com
APP_SEED_ADMIN_PASSWORD=admin123
# Catálogo de demostración (productos, tienda y vendedor de ejemplo).
APP_SEED_DEMO_DATA=true

# ----------------------------------------------------------------------------
# Wompi (pagos)
# ----------------------------------------------------------------------------
# Sandbox y Producción son ambientes independientes. No mezclar llaves.
# Las llaves privadas y los secretos solo se configuran en el backend.
WOMPI_ENV=sandbox
WOMPI_CURRENCY=COP
WOMPI_FIXED_FEE_COP=700

# Sandbox (prefijos pub_test_, prv_test_, test_events_, test_integrity_).
WOMPI_TEST_PUBLIC_KEY=
WOMPI_TEST_PRIVATE_KEY=
WOMPI_TEST_EVENTS_SECRET=
WOMPI_TEST_INTEGRITY_SECRET=

# Producción (prefijos pub_prod_, prv_prod_, prod_events_, prod_integrity_).
WOMPI_PROD_PUBLIC_KEY=
WOMPI_PROD_PRIVATE_KEY=
WOMPI_PROD_EVENTS_SECRET=
WOMPI_PROD_INTEGRITY_SECRET=

# ----------------------------------------------------------------------------
# Frontend: Angular
# ----------------------------------------------------------------------------
# URL de la API que se escribe en public/config.js antes de compilar.
# En local no se define: config.js apunta a http://localhost:8080/api.
# PARDROPS_API_URL=https://pardrops-api.onrender.com/api

# ----------------------------------------------------------------------------
# Pipeline (solo GitHub Actions / uso puntual, nunca en el repo)
# ----------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# NEON_API_KEY=
