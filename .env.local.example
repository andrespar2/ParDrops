# Plantilla de configuración local.
# Copia este archivo como .env.local y completa los valores.
# .env.local está ignorado por git y dev.ps1 lo carga al arrancar.

# Credenciales de OAuth de Google Cloud Console.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Opcionales:
# APP_FRONTEND_URL=http://localhost:4200
# APP_OAUTH2_SECURE_COOKIES=false

# Correo transaccional. Sin SMTP, los correos se guardan en ./data/mail-outbox.
MAIL_ENABLED=false
MAIL_FROM=no-reply@pardrops.local
MAIL_FROM_NAME=ParDrops

# Para enviar correos reales (por ejemplo, Gmail con contraseña de aplicación):
# MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@gmail.com
# MAIL_PASSWORD=tu-contraseña-de-aplicacion
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
