# Plantilla de configuración local.
# Copia este archivo como .env.local y completa los valores.
# .env.local está ignorado por git y dev.ps1 lo carga al arrancar.

# Credenciales de OAuth de Google Cloud Console.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Opcionales:
# APP_FRONTEND_URL=http://localhost:4200
# APP_OAUTH2_SECURE_COOKIES=false
