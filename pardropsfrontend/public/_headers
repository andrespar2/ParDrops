# Cabeceras de Cloudflare Pages.

# La configuración de ejecución debe revalidarse siempre: si cambia la URL de
# la API, el navegador no puede seguir usando una copia antigua.
/config.js
  Cache-Control: no-cache

# El HTML de entrada no se cachea para que un despliegue nuevo se vea al momento.
/index.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Los assets con hash del build son inmutables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Angular emite los chunks y estilos en la raíz con hash en el nombre.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cabeceras de seguridad comunes para toda la aplicación.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
